<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_ocr_invoice_form" model="ir.ui.view">
    <field name="name">ocr.invoice.form</field>
    <field name="model">ocr.document</field>
    <field name="arch" type="xml">
      <form string="Upload Invoice">
        <sheet>

          <div class="oe_title">
            <h1>Upload Invoice</h1>
            <div class="text-muted" style="margin-top:6px;">
              Upload a PDF or image. Then run OCR to extract full enterprise fields.
            </div>
          </div>

          <group col="2">
            <field name="document_type" readonly="1"/>
            <field name="name" readonly="1"/>

            <field name="file_filename" invisible="1"/>
            <field name="file" filename="file_filename" required="1"/>

            <field name="status" readonly="1"/>
            <field name="progress" readonly="1"/>
          </group>

          <footer>
            <button name="action_run_ocr" type="object" string="Run" class="btn-primary"/>
            <button string="Go to History" type="action" name="%(erp_ocr_addon.action_ocr_document_list)d" class="btn-secondary"/>
          </footer>

        </sheet>
      </form>
    </field>
  </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_ocr_dashboard_form" model="ir.ui.view">
    <field name="name">ocr.dashboard.form</field>
    <field name="model">ocr.dashboard</field>
    <field name="arch" type="xml">
      <form string="Operations Overview" create="false" edit="false">
        <sheet>

          <div class="oe_title" style="margin-bottom: 20px;">
            <h1 style="color:#374151;">Operations Overview</h1>
          </div>

          <div class="row" style="margin-bottom: 30px;">

            <div class="col-3">
              <button name="action_open_invoices" type="object"
                      style="width:100%; height:120px; border:1px solid #E5E7EB; border-radius:12px; background:white; padding:15px; text-align:center; cursor:pointer;">
                <div style="font-size:36px; font-weight:800; color:#4F46E5;">
                    <field name="invoice_count"/>
                </div>
                <div style="color:#6B7280; font-weight:600; font-size:14px; text-transform:uppercase;">Invoices</div>
              </button>
            </div>

            <div class="col-3">
              <button name="action_open_receipts" type="object"
                      style="width:100%; height:120px; border:1px solid #E5E7EB; border-radius:12px; background:white; padding:15px; text-align:center; cursor:pointer;">
                <div style="font-size:36px; font-weight:800; color:#059669;">
                    <field name="receipt_count"/>
                </div>
                <div style="color:#6B7280; font-weight:600; font-size:14px; text-transform:uppercase;">Receipts</div>
              </button>
            </div>

            <div class="col-3">
              <div style="width:100%; height:120px; border:1px solid #E5E7EB; border-radius:12px; background:#F9FAFB; padding:15px; display:flex; flex-direction:column; align-items:center; justify-content:center;">
                <div style="font-size:28px; font-weight:800; color:#111827;">
                    <field name="total_processed_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </div>
                <div style="color:#6B7280; font-size:12px; margin-top:4px;">Total Value</div>
              </div>
            </div>

            <div class="col-3">
               <button name="action_open_failed" type="object"
                       style="width:100%; height:120px; border:1px solid #FECACA; border-radius:12px; background:#FEF2F2; padding:15px; text-align:center; cursor:pointer;">
                <div style="font-size:36px; font-weight:800; color:#DC2626;">
                    <field name="failed_count"/>
                </div>
                <div style="color:#DC2626; font-weight:600; font-size:14px; text-transform:uppercase;">Failed</div>
              </button>
            </div>

          </div>

          <div style="margin-top:20px;">
              <h3 style="color:#374151; margin-bottom:15px; border-bottom:1px solid #E5E7EB; padding-bottom:10px;">Recent Activity</h3>
              <field name="recent_document_ids" readonly="1">
                <tree decoration-danger="status=='failed'" decoration-success="status=='done'" decoration-muted="status=='draft'" limit="10">
                    <field name="create_date" string="Time"/>
                    <field name="invoice_id" string="Doc #"/>
                    <field name="document_type"/>
                    <field name="vendor_name"/>
                    <field name="total_amount" widget="monetary"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'done'"
                           decoration-warning="status == 'processing'"
                           decoration-danger="status == 'failed'"/>
                </tree>
              </field>
          </div>

        </sheet>
      </form>
    </field>
  </record>
</odoo>
